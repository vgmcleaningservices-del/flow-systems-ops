# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Shared team login code (whatever you want, e.g. "flowsystems2026") and a random secret
# used to sign the session cookie. Generate SESSION_SECRET with: openssl rand -hex 32
TEAM_ACCESS_CODE=change-me
SESSION_SECRET=change-me-too

# Persoonlijke inlogcode per persoon -- naast de gedeelde teamcode hierboven.
# Verifieert wie iemand is, zodat taken-doorsturen niet op een vrij te kiezen
# naam vertrouwt. Kies per persoon iets unieks, geen wachtwoordbeleid nodig
# voor 5 mensen die elkaar vertrouwen -- wel geheimhouden zoals de teamcode.
CREW_CODE_MATTHIAS=change-me
CREW_CODE_LAURENS=change-me
CREW_CODE_RUNAR=change-me
CREW_CODE_SEBA=change-me
CREW_CODE_ZENDE=change-me

# Shared secret you also paste into every GitHub webhook (Settings -> Webhooks -> Secret)
GITHUB_WEBHOOK_SECRET=change-me-as-well
